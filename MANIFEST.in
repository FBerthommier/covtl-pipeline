# examples/ (demo scripts, MP4s, interactive HTML demos) is
# repository-only: it never ships in the sdist (this prune) nor in
# the wheel (the vtl_synth* allowlist in pyproject.toml) —
# pip install pulls in vtl_synth/ only.
prune examples
# interactive HTML demos moved to docs/html (GitHub Pages source):
# repository-only as well — never in the sdist
prune docs/html
