      <static_params>
        <param index="0" name="RT" description="Rest thickness" unit="cm" min="0.300000" max="1.000000" neutral="0.450000" />
        <param index="1" name="RL" description="Rest length" unit="cm" min="0.500000" max="2.000000" neutral="1.600000" />
