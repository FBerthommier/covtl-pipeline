# Speaker definitions are validated by SHA-256 against
# vtl_synth/data/speakers/registry.json — git must never normalize
# their line endings (a CRLF smudge changes the hash).
*.speaker -text
# Same rule for the per-speaker constants sources shipped next to the
# registry: they are hash-pinned too, so the blob must be checked out
# byte-identical on every platform (completes the platform-independent
# registry hashes of b2c87a8, which only covered *.speaker).
vtl_synth/data/speakers/*_constants.py -text
